    knob.BorderSizePixel = 0
    knob.Position = UDim2.new(0, 3, 0.5, -8)
    knob.Size = UDim2.new(0, 16, 0, 16)
    knob.Parent = switchBg
    local kbc = Instance.new("UICorner"); kbc.CornerRadius = UDim.new(1, 0); kbc.Parent = knob
    local function refresh()
        local on = getState()
        if on then
            tween(switchBg, {BackgroundColor3 = onColor}, 0.2)
            tween(knob, {Position = UDim2.new(1, -19, 0.5, -8)}, 0.2, Enum.EasingStyle.Back)
            tween(knob, {BackgroundColor3 = C.text}, 0.2)
        else
            tween(switchBg, {BackgroundColor3 = C.gray}, 0.2)
            tween(knob, {Position = UDim2.new(0, 3, 0.5, -8)}, 0.2, Enum.EasingStyle.Back)
        end
    end
    refresh()
    local btn = Instance.new("TextButton")
    btn.BackgroundTransparency = 1
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.Text = ""
    btn.Parent = card
    btn.MouseButton1Click:Connect(function()
        setState(not getState())
        refresh()
    end)
    return card, refresh
end

