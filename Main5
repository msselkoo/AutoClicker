-- Diamonds update loop
task.spawn(function()
    while running do
        local val = getDiamonds()
        if val ~= nil then
            diamondsCurrent = val
            if diamondsStart == nil then diamondsStart = val end
            diamondsGain = val - (diamondsStart or val)
            diamondVal.Text = formatNumber(val) .. "  (+" .. formatNumber(diamondsGain) .. ")"
        end
        task.wait(1)
    end
end)

-- UI update loop
task.spawn(function()
    while running do
        if autoClicking and sessionStart then
            sessionTime = tick() - sessionStart
            local mins = math.floor(sessionTime / 60)
            local secs = math.floor(sessionTime % 60)
            sessionVal.Text = string.format("%dm %ds", mins, secs)
            local now = tick()
            while #clickTimestamps > 0 and (now - clickTimestamps[1]) > 1 do
                table.remove(clickTimestamps, 1)
            end
            cpsVal.Text = string.format("%.1f", #clickTimestamps)
            totalVal.Text = tostring(totalClicks)
        else
            sessionVal.Text = "0s"
            cpsVal.Text = "0.0"
            totalVal.Text = tostring(totalClicks)
        end
        task.wait(0.1)
    end
end)

