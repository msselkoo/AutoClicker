local function makeLabel(parent, text, y, size, color, bold, x)
    x = x or 0
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Position = UDim2.new(0, x, 0, y)
    l.Size = UDim2.new(1, -x, 0, size or 20)
    l.Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham
    l.Text = text
    l.TextColor3 = color or C.text
    l.TextSize = size and (size < 16 and size or 13) or 13
    if size and size >= 16 then l.TextSize = size * 0.75 end
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Parent = parent
    return l
end

