local function formatNumber(n)
    if n == nil then return "N/A" end
    n = math.floor(n)
    local s = tostring(math.abs(n))
    local formatted = ""
    local len = #s
    for i = 1, len do
        formatted = formatted .. s:sub(i, i)
        if (len - i) % 3 == 0 and i < len then
            formatted = formatted .. ","
        end
    end
    if n < 0 then formatted = "-" .. formatted end
    if math.abs(n) >= 1e9 then return string.format("%.2fB", n / 1e9)
    elseif math.abs(n) >= 1e6 then return string.format("%.2fM", n / 1e6)
    elseif math.abs(n) >= 1e3 then return formatted
    else return s end
end

local function getDiamonds()
    local ls = player:FindFirstChild("leaderstats")
    if ls then
        local d = ls:FindFirstChild("Diamonds")
        if d then return d.Value end
    end
    return nil
end

local function getGems()
    local ls = player:FindFirstChild("leaderstats")
    if ls then
        for _, v in ipairs(ls:GetChildren()) do
            if v.Name:lower():find("gem") then
                if v:IsA("IntValue") or v:IsA("NumberValue") then
                    return v.Value
                end
            end
        end
    end
    for k, v in pairs(player:GetAttributes()) do
        if tostring(k):lower():find("gem") and type(v) == "number" then
            return v
        end
    end
    return nil
end

