            diamondsCurrent = val
            if diamondsStart == nil then diamondsStart = val end
            diamondsGain = val - (diamondsStart or val)
            diamondVal.Text = formatNumber(val)
        end
        task.wait(1)
    end
end)

-- Gems: pokazuje przyrosty (+10, +100) i się powiększa
task.spawn(function()
    task.wait(1.5)
    local val = getGems()
    if val ~= nil then
        gemsCurrent = val
        gemsStart = val
        gemsGain = 0
        gemsLastValue = val
        gemVal.Text = "0"
        gemInc.Text = ""
        notify("PSX", "Gems tracking started: " .. formatNumber(val), C.gold)
    else
        gemVal.Text = "N/A"
        gemVal.TextColor3 = C.red
    end
end)

task.spawn(function()
    while running do
        local val = getGems()
        if val ~= nil then
            if gemsLastValue ~= nil then
                local diff = val - gemsLastValue
                if diff > 0 then
                    -- Pokaż przyrost (+10, +100, itd.)
                    gemInc.Text = "+" .. formatNumber(diff)
                    gemInc.TextColor3 = C.green
                    -- Animacja: powiększ tekst
                    tween(gemInc, {TextSize = 20}, 0.15)
                    task.wait(0.15)
                    tween(gemInc, {TextSize = 16}, 0.3)
                    -- Znikanie po 1.5s
                    task.delay(1.5, function()
                        if gemInc and gemInc.Parent then
                            tween(gemInc, {TextTransparency = 1}, 0.3)
                            task.wait(0.35)
                            if gemInc and gemInc.Parent then
                                gemInc.Text = ""
                                gemInc.TextTransparency = 0
                            end
                        end
                    end)
                elseif diff < 0 then
                    gemInc.Text = formatNumber(diff)
                    gemInc.TextColor3 = C.red
                    tween(gemInc, {TextSize = 20}, 0.15)
                    task.wait(0.15)
                    tween(gemInc, {TextSize = 16}, 0.3)
                    task.delay(1.5, function()
                        if gemInc and gemInc.Parent then
                            tween(gemInc, {TextTransparency = 1}, 0.3)
                            task.wait(0.35)
                            if gemInc and gemInc.Parent then
                                gemInc.Text = ""
                                gemInc.TextTransparency = 0
                            end
                        end
                    end)
                end
            end
            gemsCurrent = val
            gemsLastValue = val
            if gemsStart == nil then gemsStart = val end
            gemsGain = val - (gemsStart or val)
            -- Akumulowany przyrost
            if gemsGain >= 0 then
                gemVal.Text = "+" .. formatNumber(gemsGain)
                gemVal.TextColor3 = C.gold
            else
                gemVal.Text = formatNumber(gemsGain)
                gemVal.TextColor3 = C.red
            end
        end
        task.wait(1)
    end
end)

-- UI update loop
task.spawn(function()
    while running do
        if autoClicking and sessionStart then
            sessionTime = tick() - sessionStart
            local mins = math.floor(sessionTime / 60)
            local secs = math.floor(sessionTime % 60)
            if mins > 0 then
                sessionVal.Text = string.format("%dm %ds", mins, secs)
            else
                sessionVal.Text = string.format("%ds", secs)
            end
            local now = tick()
            while #clickTimestamps > 0 and (now - clickTimestamps[1]) > 1 do
                table.remove(clickTimestamps, 1)
            end
            cpsVal.Text = string.format("%.1f", #clickTimestamps)
            totalVal.Text = tostring(totalClicks)
        else
            sessionVal.Text = "0s"
            cpsVal.Text = "0.0"
            totalVal.Text = tostring(totalClicks)
        end
        task.wait(0.1)
    end
end)

