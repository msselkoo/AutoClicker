-- Hookuj RemoteEventy związane z walutami
print("===== HOOKOWANIE REMOTE'ÓW =====")
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    if method == "FireServer" or method == "InvokeServer" then
        local name = tostring(self.Name):lower()
        if name:find("currency") or name:find("coin") or name:find("diamond") or name:find("candy") or name:find("save") or name:find("data") then
            print("[REMOTE] " .. self:GetFullName() .. " (" .. method .. ") args=" .. #args)
            for i, a in ipairs(args) do
                print("   arg" .. i .. ": " .. type(a) .. " = " .. tostring(a):sub(1, 200))
            end
        end
    end
    return oldNamecall(self, ...)
end)
print("Hook aktywny - zbieraj dane przez kilka sekund...")
task.wait(10)
print("===== KONIEC ZBIERANIA =====")
