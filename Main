-- DIAGNOSTYKA WALUT PSX
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer

local targets = {"Fantasy Coins", "Diamonds", "Halloween Candy", "Fantasy", "Candy"}

local function checkInstance(inst, path)
    if inst:IsA("IntValue") or inst:IsA("NumberValue") then
        for _, t in ipairs(targets) do
            if inst.Name:lower():find(t:lower(), 1, true) then
                print("[VAL] " .. path .. " = " .. tostring(inst.Value))
            end
        end
    end
    -- Atrybuty
    for attrName, attrVal in pairs(inst:GetAttributes()) do
        for _, t in ipairs(targets) do
            if tostring(attrName):lower():find(t:lower(), 1, true) then
                print("[ATTR] " .. path .. " :: " .. attrName .. " = " .. tostring(attrVal))
            end
        end
    end
end

print("===== LEADERSTATS =====")
local ls = player:FindFirstChild("leaderstats")
if ls then
    for _, v in ipairs(ls:GetChildren()) do
        print("  " .. v.Name .. " = " .. tostring(v.Value) .. " (" .. v.ClassName .. ")")
    end
else
    print("  brak leaderstats")
end

print("===== ATRYBUTY GRACZA =====")
for k, v in pairs(player:GetAttributes()) do
    print("  " .. k .. " = " .. tostring(v))
end

print("===== SZUKANIE W GRACZU (rekurencyjnie, max 4 poziomy) =====")
local function searchPlayer(inst, path, depth)
    if depth > 4 then return end
    checkInstance(inst, path)
    for _, child in ipairs(inst:GetChildren()) do
        searchPlayer(child, path .. "." .. child.Name, depth + 1)
    end
end
searchPlayer(player, "Player", 0)

print("===== SZUKANIE W REPLICATEDSTORAGE (rekurencyjnie, max 3 poziomy) =====")
local function searchRS(inst, path, depth)
    if depth > 3 then return end
    checkInstance(inst, path)
    for _, child in ipairs(inst:GetChildren()) do
        searchRS(child, path .. "." .. child.Name, depth + 1)
    end
end
searchRS(ReplicatedStorage, "RS", 0)

print("===== MODUŁY Z 'Currency' w nazwie =====")
for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
    if v:IsA("ModuleScript") and v.Name:lower():find("currency") then
        print("  " .. v:GetFullName())
    end
end

print("===== KONIEC DIAGNOSTYKI =====")
