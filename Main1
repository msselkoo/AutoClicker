UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if waitingForKey and input.UserInputType == Enum.UserInputType.Keyboard then
        toggleKey = input.KeyCode
        keybindBtn.Text = input.KeyCode.Name
        waitingForKey = false
        notify("Keybind", "Toggle key set to " .. input.KeyCode.Name, C.purpleLight)
        return
    end
    if input.KeyCode == toggleKey then
        autoClicking = not autoClicking
        if autoClicking then
            sessionStart = tick()
            totalClicks = 0
            clickTimestamps = {}
        else
            sessionStart = nil
        end
        updateStatus()
        notify("AutoClicker", autoClicking and "AutoClicker is ON" or "AutoClicker is OFF", autoClicking and C.green or C.red)
    end
    if input.KeyCode == Enum.KeyCode.Insert then
        main.Visible = not main.Visible
    end
end)

task.spawn(function()
    while running do
        if autoClicking then
            local x, y = targetPos.X, targetPos.Y
            VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
            task.wait()
            VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
            totalClicks = totalClicks + 1
            table.insert(clickTimestamps, tick())
            local now = tick()
            while #clickTimestamps > 0 and (now - clickTimestamps[1]) > 1 do
                table.remove(clickTimestamps, 1)
            end
            task.wait(clickSpeed)
        else
            task.wait(0.1)
        end
    end
end)

task.spawn(function()
    while running do
        if antiAfkEnabled then
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.A, false, game)
            task.wait(0.1)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.A, false, game)
            task.wait(0.1)
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.D, false, game)
            task.wait(0.1)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.D, false, game)
            task.wait(antiAfkInterval)
        else
            task.wait(0.5)
        end
    end
end)

-- Inicjalizacja Diamonds (wartosc startowa)
task.spawn(function()
    task.wait(1)
    local val = getDiamonds()
    if val ~= nil then
        diamondsCurrent = val
        diamondsStart = val
        diamondsGain = 0
        if diamondsLabel then
            diamondsLabel.Text = "Diamonds: " .. formatNumber(val) .. "  (+0)"
            diamondsLabel.TextColor3 = C.cyan
        end
        notify("PSX", "Diamonds tracking started: " .. formatNumber(val), C.cyan)
    else
        if diamondsLabel then
            diamondsLabel.Text = "Diamonds: N/A (not found)"
            diamondsLabel.TextColor3 = C.red
        end
    end
end)

-- Petla aktualizacji Diamonds
task.spawn(function()
    while running do
        local val = getDiamonds()
        if val ~= nil then
            diamondsCurrent = val
            if diamondsStart == nil then
                diamondsStart = val
            end
            diamondsGain = val - (diamondsStart or val)
            if diamondsLabel then
                diamondsLabel.Text = "Diamonds: " .. formatNumber(val) .. "  (+" .. formatNumber(diamondsGain) .. ")"
                diamondsLabel.TextColor3 = C.cyan
            end
        end
        task.wait(1)
    end
end)

task.spawn(function()
    while running do
        if autoClicking and sessionStart then
            sessionTime = tick() - sessionStart
            local mins = math.floor(sessionTime / 60)
            local secs = math.floor(sessionTime % 60)
            local timeStr = string.format("%dm %ds", mins, secs)
            if sessionTimeLabel then
                sessionTimeLabel.Text = "Session time: " .. timeStr
                sessionTimeLabel.TextColor3 = C.yellow
            end
            local now = tick()
            while #clickTimestamps > 0 and (now - clickTimestamps[1]) > 1 do
                table.remove(clickTimestamps, 1)
            end
            local cps = #clickTimestamps
            if cpsLabel then
                cpsLabel.Text = string.format("CPS: %.1f", cps)
                cpsLabel.TextColor3 = C.purpleLight
            end
            if totalLabel then
                totalLabel.Text = "Total clicks: " .. totalClicks
                totalLabel.TextColor3 = C.text
            end
        else
            if sessionTimeLabel then
                sessionTimeLabel.Text = "Session time: 0s"
                sessionTimeLabel.TextColor3 = C.textDim
            end
            if cpsLabel then
                cpsLabel.Text = "CPS: 0.0"
                cpsLabel.TextColor3 = C.textDim
            end
            if totalLabel then
                totalLabel.Text = "Total clicks: " .. totalClicks
                totalLabel.TextColor3 = C.textDim
            end
        end
        task.wait(0.1)
    end
end)

