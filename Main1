local function makeLabel(parent, text, y, size, color, bold)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Position = UDim2.new(0, 0, 0, y)
    l.Size = UDim2.new(1, 0, 0, size or 20)
    l.Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham
    l.Text = text
    l.TextColor3 = color or C.text
    l.TextSize = 13
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Parent = parent
    return l
end

local function makeButton(parent, text, y, onClick, color)
    color = color or C.purple
    local b = Instance.new("TextButton")
    b.BackgroundColor3 = color
    b.BorderSizePixel = 0
    b.Position = UDim2.new(0, 0, 0, y)
    b.Size = UDim2.new(1, 0, 0, 32)
    b.Font = Enum.Font.GothamBold
    b.Text = text
    b.TextColor3 = C.text
    b.TextSize = 14
    b.Parent = parent
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 8)
    c.Parent = b
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, color), ColorSequenceKeypoint.new(1, C.bg2)})
    g.Rotation = 90
    g.Parent = b
    local s = Instance.new("UIStroke")
    s.Color = C.purpleLight
    s.Thickness = 1
    s.Transparency = 0.5
    s.Parent = b
    b.MouseButton1Click:Connect(onClick)
    b.MouseEnter:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = C.purpleLight}):Play()
    end)
    b.MouseLeave:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = color}):Play()
    end)
    return b
end

local function makeToggle(parent, text, y, getState, setState, onColor)
    onColor = onColor or C.green
    local row = Instance.new("Frame")
    row.BackgroundTransparency = 1
    row.Position = UDim2.new(0, 0, 0, y)
    row.Size = UDim2.new(1, 0, 0, 32)
    row.Parent = parent
    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Size = UDim2.new(1, -60, 1, 0)
    lbl.Font = Enum.Font.Gotham
    lbl.Text = text
    lbl.TextColor3 = C.text
    lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextWrapped = true
    lbl.Parent = row
    local btn = Instance.new("TextButton")
    btn.BackgroundColor3 = C.gray
    btn.BorderSizePixel = 0
    btn.Position = UDim2.new(1, -52, 0.5, -11)
    btn.Size = UDim2.new(0, 52, 0, 22)
    btn.Font = Enum.Font.GothamBold
    btn.Text = "OFF"
    btn.TextColor3 = C.text
    btn.TextSize = 12
    btn.Parent = row
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 11)
    c.Parent = btn
    local function refresh()
        local on = getState()
        btn.Text = on and "ON" or "OFF"
        btn.BackgroundColor3 = on and onColor or C.gray
    end
    refresh()
    btn.MouseButton1Click:Connect(function()
        setState(not getState())
        refresh()
    end)
    return row, refresh
end

