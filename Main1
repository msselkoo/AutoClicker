local Players = game:GetService("Players")
local player = Players.LocalPlayer

print("===== SZUKANIE GUI Z WALUTAMI =====")

-- Wzorce tekstów walut
local patterns = {"%d+%s*coins?", "%d+%s*diamonds?", "%d+%s*cand", "%d+%s*gems?"}
local found = 0

local function scanGui(inst, depth)
    if depth > 8 then return end
    if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
        local txt = inst.Text
        if txt and #txt > 0 and #txt < 50 then
            local low = txt:lower()
            if low:find("coin") or low:find("diamond") or low:find("candy") or low:find("gem") or low:find("fantasy") then
                found = found + 1
                print("  [" .. inst.ClassName .. "] " .. inst:GetFullName())
                print("      TEXT: '" .. txt .. "'")
                print("      VISIBLE: " .. tostring(inst.Visible))
            end
        end
    end
    for _, c in ipairs(inst:GetChildren()) do
        scanGui(c, depth + 1)
    end
end

if player:FindFirstChild("PlayerGui") then
    scanGui(player.PlayerGui, 0)
end
print("Znaleziono " .. found .. " elementów GUI z walutami")

-- Szukaj też w CoreGui (niektóre gry trzymają HUD tam)
print("===== COREGUI =====")
local cg = game:GetService("CoreGui")
local cgFound = 0
local function scanCG(inst, depth)
    if depth > 6 then return end
    if inst:IsA("TextLabel") then
        local txt = inst.Text
        if txt and #txt > 0 and #txt < 50 then
            local low = txt:lower()
            if low:find("coin") or low:find("diamond") or low:find("candy") or low:find("gem") then
                cgFound = cgFound + 1
                print("  " .. inst:GetFullName() .. " => '" .. txt .. "'")
            end
        end
    end
    for _, c in ipairs(inst:GetChildren()) do
        scanCG(c, depth + 1)
    end
end
scanCG(cg, 0)
print("CoreGui: " .. cgFound)

